VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Enable the roster draw after production approval of the ability catalog.
VITE_ROSTER_ABILITY_DRAW_ENABLED=false
# Optional backend override; VITE_SUPABASE_URL is used when omitted.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Required for server-side match result persistence; never expose via VITE_.
SUPABASE_SECRET_KEY=SUPABASE_SECRET_KEY
# Optional override only when frontend/backend use separate hosts.
# VITE_GAME_SERVER_URL=wss://YOUR_BACKEND/socket
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
PORT=3001
