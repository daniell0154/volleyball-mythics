--!strict
return function(root: Instance)
	local Session = require(root.Session)
	local s = Session.new("duel-test", "Online1v1", 101, "fundamentals", "A", "normal", 42)
	assert(#s.runtime.athletes == 2 and s.runtime.bots == nil and s.runtime.warmup)
	s.runtime:point("B", "test")
	assert(s.runtime.state.score.B == 0 and s.runtime.state.phase == "serving")
	assert(s:join(102, "fundamentals", 1))
	assert(s.runtime.state.phase == "countdown" and not s.runtime.warmup)
	assert(s.runtime.state.score.A == 0 and s.runtime.state.score.B == 0)
	s.runtime:step()
	local tick = s.runtime.tick
	s:leave(102, false, 5)
	s:step(6)
	assert(s.runtime.suspended and s.runtime.tick == tick and s.reservations[102].expires == 25)
	assert(s:join(102, "fundamentals", 10))
	assert(s.runtime.suspended)
	s:step(13)
	assert(not s.runtime.suspended and s.disconnectUsed[102] == 5)
	s:leave(102, false, 20)
	s:step(41)
	assert(s.runtime.state.phase == "finished" and s.runtime.state.reason == "forfeit" and s.runtime.state.winner == "A")
	assert(s.runtime.state.score.A == 0)
	for _, a in s.runtime.athletes do assert(not a.bot) end
	local r = Session.new("rematch", "Online1v1", 1, "fundamentals", "A", "normal", 1)
	r:join(2, "fundamentals", 0)
	r:finish("A", "forfeit")
	assert(not r:vote(1, "new"))
	assert(r:vote(2, "new"))
	assert(r.runtime.state.matchId == "new" and r.runtime.state.phase == "countdown")
	r:leave(1, true, 4)
	assert(r.runtime.state.phase == "finished" and r.runtime.state.winner == "B")
	return { scenarios = 8, bots = 0 }
end
